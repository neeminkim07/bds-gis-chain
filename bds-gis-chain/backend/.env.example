# Copy this file to backend/.env. The database URL matches docker-compose.yml.
DATABASE_URL=postgres://postgres:1234@localhost:5431/bds_gis
PORT=4000

# Replace with a random value of at least 32 characters.
# Generate from the backend directory with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-this-placeholder-with-a-random-secret

# Cấu hình kết nối Blockchain Hardhat local
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Default account #0 của Hardhat local node
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Địa chỉ contract PropertyRegistry sau khi deploy
CONTRACT_ADDRESS=
